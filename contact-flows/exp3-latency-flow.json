{
  "Version": "2019-10-30",
  "StartAction": "entry",
  "Actions": [
    {
      "Identifier": "entry",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Connected in region $.AwsRegion. Experiment three, speech latency."
      },
      "Transitions": {
        "NextAction": "lex-input",
        "Errors": [
          {
            "NextAction": "lex-input",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "lex-input",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "Text": "How can I help you today? You can ask to look up your account or check an order.",
        "LexV2Bot": {
          "AliasArn": "arn:aws:lex:$.AwsRegion:ACCOUNT_ID:bot-alias/BOT_ID/BOT_ALIAS_ID"
        }
      },
      "Transitions": {
        "NextAction": "ok",
        "Conditions": [
          {
            "NextAction": "ok",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "LookupCustomer"
              ]
            }
          },
          {
            "NextAction": "ok",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "CheckOrderStatus"
              ]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "lex-slow",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "lex-slow",
            "ErrorType": "NoMatchingCondition"
          }
        ]
      }
    },
    {
      "Identifier": "ok",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "I found your information. Transferring to an agent."
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [
          {
            "NextAction": "disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "lex-slow",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "The lookup service is taking too long. This is experiment three."
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [
          {
            "NextAction": "disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "disconnect",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
