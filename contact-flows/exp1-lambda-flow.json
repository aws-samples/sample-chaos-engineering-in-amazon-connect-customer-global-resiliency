{
  "Version": "2019-10-30",
  "StartAction": "entry",
  "Actions": [
    {
      "Identifier": "entry",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Connected in region $.AwsRegion. Experiment one, account lookup."
      },
      "Transitions": {
        "NextAction": "ask",
        "Errors": [
          {
            "NextAction": "ask",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "ask",
      "Type": "GetParticipantInput",
      "Parameters": {
        "Text": "Please enter your five digit account number, followed by the pound key.",
        "InputTimeLimitSeconds": "10",
        "StoreInput": "True",
        "InputValidation": {
          "CustomValidation": {
            "MaximumLength": "5"
          }
        },
        "DTMFConfiguration": {
          "InterdigitTimeLimitSeconds": "5"
        }
      },
      "Transitions": {
        "NextAction": "lookup",
        "Errors": [
          {
            "NextAction": "lookup-down",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "lookup",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "arn:aws:lambda:$.AwsRegion:ACCOUNT_ID:function:ConnectChaos-AccountLookup",
        "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": {
          "AccountId": "$.StoredCustomerInput"
        },
        "ResponseValidation": {
          "ResponseType": "STRING_MAP"
        }
      },
      "Transitions": {
        "NextAction": "check",
        "Errors": [
          {
            "NextAction": "lookup-down",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "check",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.External.status"
      },
      "Transitions": {
        "NextAction": "not-found",
        "Conditions": [
          {
            "NextAction": "found",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "FOUND"
              ]
            }
          },
          {
            "NextAction": "not-found",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "NOT_FOUND"
              ]
            }
          },
          {
            "NextAction": "no-input",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "INVALID_INPUT"
              ]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "not-found",
            "ErrorType": "NoMatchingCondition"
          }
        ]
      }
    },
    {
      "Identifier": "found",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Welcome back, $.External.customer_name. Your account is in good standing."
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [
          {
            "NextAction": "disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "not-found",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "That account number was not found. Please check it and call again."
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [
          {
            "NextAction": "disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "no-input",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "No account number was received."
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [
          {
            "NextAction": "disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "lookup-down",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "The account lookup service is unavailable. This is experiment one."
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [
          {
            "NextAction": "disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "disconnect",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
