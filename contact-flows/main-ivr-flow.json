{
  "Version": "2019-10-30",
  "StartAction": "entry-point",
  "Metadata": {
    "entryPointPosition": {"x": 20, "y": 20},
    "ActionMetadata": {}
  },
  "Actions": [
    {
      "Identifier": "entry-point",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Welcome to our customer service line. I can help you look up your account or check an order status."
      },
      "Transitions": {
        "NextAction": "get-customer-input",
        "Errors": [
          {"NextAction": "error-disconnect", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "get-customer-input",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "LexV2Bot": {
          "AliasArn": "PLACEHOLDER_LEX_BOT_ALIAS_ARN"
        }
      },
      "Transitions": {
        "NextAction": "lex-error-handling",
        "Conditions": [
          {
            "NextAction": "lookup-success",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["LookupCustomer"]
            }
          },
          {
            "NextAction": "order-success",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["CheckOrderStatus"]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "lex-error-handling",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "lex-error-handling",
            "ErrorType": "NoMatchingCondition"
          }
        ]
      }
    },
    {
      "Identifier": "lookup-success",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "I've found your account. Let me transfer you to an agent who can assist further."
      },
      "Transitions": {
        "NextAction": "transfer-to-queue",
        "Errors": [
          {"NextAction": "error-disconnect", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "order-success",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "I have your order information. Transferring you to support."
      },
      "Transitions": {
        "NextAction": "transfer-to-queue",
        "Errors": [
          {"NextAction": "error-disconnect", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "lex-error-handling",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "I'm sorry, we're experiencing technical difficulties. Let me transfer you to an agent."
      },
      "Transitions": {
        "NextAction": "transfer-to-queue",
        "Errors": [
          {"NextAction": "error-disconnect", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "transfer-to-queue",
      "Type": "TransferContactToQueue",
      "Parameters": {
        "QueueId": "PLACEHOLDER_QUEUE_ID"
      },
      "Transitions": {
        "NextAction": "end-contact",
        "Errors": [
          {"NextAction": "error-disconnect", "ErrorType": "NoMatchingError"},
          {"NextAction": "error-disconnect", "ErrorType": "QueueAtCapacity"}
        ]
      }
    },
    {
      "Identifier": "error-disconnect",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "We apologize for the inconvenience. Please try calling again later."
      },
      "Transitions": {
        "NextAction": "end-contact",
        "Errors": [
          {"NextAction": "end-contact", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "end-contact",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
