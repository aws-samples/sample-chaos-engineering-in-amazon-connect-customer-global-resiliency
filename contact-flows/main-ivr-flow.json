{
  "Version": "2019-10-30",
  "StartAction": "entry",
  "Actions": [
    {
      "Identifier": "entry",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Welcome to customer service. I can help you look up your account or check an order."
      },
      "Transitions": {
        "NextAction": "log-call",
        "Errors": [
          {
            "NextAction": "error-msg",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "log-call",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "arn:aws:lambda:$.AwsRegion:ACCOUNT_ID:function:ConnectChaos-CallLogger",
        "InvocationTimeLimitSeconds": "8"
      },
      "Transitions": {
        "NextAction": "lex-input",
        "Errors": [
          {
            "NextAction": "error-msg",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "lex-input",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "Text": "How can I help you today? You can ask to look up your account or check an order.",
        "LexV2Bot": {
          "AliasArn": "arn:aws:lex:$.AwsRegion:ACCOUNT_ID:bot-alias/BOT_ID/BOT_ALIAS_ID"
        }
      },
      "Transitions": {
        "NextAction": "success-msg",
        "Conditions": [
          {
            "NextAction": "success-msg",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "LookupCustomer"
              ]
            }
          },
          {
            "NextAction": "success-msg",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "CheckOrderStatus"
              ]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "error-msg",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "error-msg",
            "ErrorType": "NoMatchingCondition"
          }
        ]
      }
    },
    {
      "Identifier": "success-msg",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "I found your information. Transferring to an agent."
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [
          {
            "NextAction": "disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "error-msg",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "We are experiencing difficulties. Please try again later."
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [
          {
            "NextAction": "disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "disconnect",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
